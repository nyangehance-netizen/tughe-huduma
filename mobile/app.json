{
  "expo": {
    "name": "TUGHE Huduma",
    "slug": "tughe-huduma",
    "scheme": "tughe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2D3597"
    },
    "ios": {
      "bundleIdentifier": "tz.or.tughe.huduma",
      "supportsTablet": true,
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "tz.or.tughe.huduma",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2D3597"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "TUGHE Huduma hutumia Face ID kulinda taarifa zako. / TUGHE Huduma uses Face ID to protect your information."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
